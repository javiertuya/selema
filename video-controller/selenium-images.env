# Docker-selenium images used by the CI, the local development scripts and the server.
# Pass this file to the compose files with docker compose --env-file (variables exported in the shell take precedence).
# These are the latest versions compatible with Selema, see issue https://github.com/javiertuya/selema/issues/1061
# Update the three together (same docker-selenium release) and let test.yml validate them before deploying to the server.
# Syntax must be valid for compose --env-file, bash and $GITHUB_ENV: KEY=value, no quotes or spaces, comments in their own lines.
NODE_IMAGE=selenium/standalone-chrome:157.0-20261101
VIDEO_IMAGE=selenium/video:ffmpeg-8.1-20261101
GRID_IMAGE=selenium/standalone-docker:4.52.0-20261101
